source_file = "/content/input.txt" destination_file = "/content/output.txt" with open(source_file,"w") as file:  file.write("Apple banana CHERRY date Elderberry Fig GRAPE") with open(source_file,"r") as file:  words = file.read().split() words = [word.lower() for word in words] words.sort() print("Words have been sorted and written to output.txt") with open(destination_file,"w") as file:  for word in words:    file.write(word + "\n")    print(f"{word}")  with open(destination_file,"r") as file:    print(file.read())
